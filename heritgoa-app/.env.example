# HeritGoa — Environment Variables
# NEVER commit this file to git. Add .env to .gitignore.
# ═══════════════════════════════════════════════════════════════

# Supabase — get these from your project dashboard at supabase.com
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# App
VITE_APP_NAME=HeritGoa
VITE_APP_ENV=development

# Sarvam AI — Feature 12: AI Heritage Translation (Text + Voice)
# Get your key at: https://sarvam.ai → Dashboard → API Keys
VITE_SARVAM_API_KEY=your-sarvam-api-key-here
